# FundScope — LLM provider configuration
# Copy to .env and fill in your key:   cp .env.example .env
# .env is git-ignored: never commit a real key.
# Precedence: CLI flags (--provider / --model) > environment / .env > defaults in src/config.py

# ── Generation (ask.py, agent.py, pipeline.py) ──────────────────────────────────
# Provider: anthropic (default) | groq | gemini | openrouter
LLM_PROVIDER=anthropic
# Model: empty = provider default (anthropic → claude-haiku-4-5). Required for other providers.
LLM_MODEL=

# ── LLM-as-judge (evaluation, phase 3) ──────────────────────────────────────────
JUDGE_PROVIDER=anthropic
# Empty = provider default (anthropic → claude-sonnet-5-5)
JUDGE_MODEL=
# Reasoning effort for the judge: low | medium | high (ignored by models without effort control)
JUDGE_EFFORT=medium

# ── API keys — one per provider; only the one in use is required ────────────────
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Cost / rate control ─────────────────────────────────────────────────────────
# Stop a run once its estimated cost reaches this many USD (partial results are kept)
LLM_MAX_COST_USD=0.50
# Minimum seconds between two LLM calls (useful on free tiers with low RPM limits)
LLM_MIN_INTERVAL_S=0

# ── Example: switch generation to Groq (model names are examples, check the provider's list)
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_MIN_INTERVAL_S=2
